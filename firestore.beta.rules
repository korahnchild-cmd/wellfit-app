//   return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
// }
// function isWithinFreeTrial() {
//   let u = userDoc();
//   return u.subscriptionStatus == 'paid' ||
//     (u.trialStartDate != null &&
//      request.time.toMillis() <
//        (timestamp.value(u.trialStartDate).toMillis() + 30 * 24 * 60 * 60 * 1000));
// }
//
// allow create: if
//   request.auth != null &&
//   request.resource.data.userId == request.auth.uid &&
//   isWithinFreeTrial();
