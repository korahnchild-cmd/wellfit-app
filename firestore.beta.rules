// firestore.beta.rules — 웰핏+ CHECK-UP 보안 규칙 (베타 오픈 전환용, 2026.7.3)
//
// 적용 시점: 베타 오픈 시 (가입 후 분석 가능, 보건소 300명·보험사 임직원 등)
// 전제: 베타 정책 = 가입 시 30일간 무료(유료 구독과 동일 혜택, 월 4회),
//       30일 경과 후 미결제 시 이용 불가. 현재는 수동 운영(Firebase Console에서
//       subscriptionStatus를 수동으로 'paid' 변경)이라는 전제 하에 작성했습니다.
//
// ⚠️ 확신 못하는 부분 — 반드시 직접 판단해서 결정해주세요
// ------------------------------------------------------------------
// 이 파일을 "로그인 필수" 조건까지만 걸지, 아니면 "30일 경과 여부"까지
// 규칙 레벨에서 강제할지 두 가지 선택지가 있습니다. 아래 A안/B안으로 나눠
// 둘 다 작성해뒀습니다 — 어느 쪽이 지금 시점에 맞을지는 성훈님 판단이 필요합니다.
//
//   [A안] 로그인만 요구 (30일 만료는 앱 화면(UI)에서만 안내, 강제 차단은
//         아직 안 함) — 지금 채택하신 "베타 수동 운영" 패턴과 가장 일치합니다.
//         메모리에 기록된 "14일 차단 로직은 베타 이후로 보류"라는 기존
//         방침과도 결이 같아서, 30일 로직도 지금 단계에서 규칙까지 걸 필요는
//         없을 수 있습니다. 아래 기본 활성화된 규칙이 A안입니다.
//
//   [B안] 30일 경과 + 미결제 시 규칙 레벨에서 write까지 강제 차단 —
//         맨 아래 주석 처리된 블록입니다. 장점은 클라이언트 코드에 버그가
//         있어도 서버(규칙) 단에서 이중으로 막아준다는 것(방어 심도).
//         단점은 (1) users 문서를 매번 get()으로 조회해야 해서 읽기 비용이
//         늘고, (2) trialStartDate 형식이 코드와 규칙에서 다르게 파싱되면
//         (예: ISO 문자열 vs Timestamp) 정상 사용자가 차단될 위험이 있어서
//         철저한 테스트 없이는 위험도가 A안보다 높습니다.
//         → 지금 시점(수동 운영 단계)에는 A안을 권장하고, B안은 자동화
//         전환(1,000명 이후) 시점에 다시 검토하는 걸 추천합니다.
// ------------------------------------------------------------------

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── reports/{reportId} — A안 (기본 활성화) ──────────────────
    // 로그인한 사용자만 자기 uid로 생성 가능. 게스트 생성 완전 차단.
    match /reports/{reportId} {
      allow create: if
        request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow read: if
        resource.data.isPublic == true ||
        (request.auth != null && request.auth.uid == resource.data.userId);

      allow update: if
        request.auth != null && request.auth.uid == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['userName', 'userCity']);

      allow delete: if false;
    }

    match /saveFailures/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ------------------------------------------------------------------
// [B안] 30일 경과 + 미결제 시 규칙 레벨 차단 (참고용, 미적용 상태)
// 적용하려면 위 reports match 블록의 create 조건을 아래로 교체하세요.
// trialStartDate가 AppContext.jsx에서 new Date().toISOString() 문자열로
// 저장되므로, 아래는 그 형식을 문자열 비교 없이 안전하게 다루기 위해
// 밀리초 변환이 필요합니다 — 실제 적용 전 반드시 별도 테스트 권장.
// ------------------------------------------------------------------
//
