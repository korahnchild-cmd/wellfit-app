// firestore.rules — 웰핏+ CHECK-UP 보안 규칙 (테스트 단계용, 2026.7.3)
//
// 적용 시점: 지금 (베타 오픈 전, 로그인 없이 분석 가능한 개발/테스트 단계)
// 전환 시점: 베타 오픈 시 firestore.beta.rules로 교체
//
// ⚠️ 확신 못하는 부분 (배포 전 확인 필요)
// ------------------------------------------------------------------
// 이 단계에서도 reports 컬렉션 "쓰기"는 완전히 열려있는 게 아니라 최소한의
// 형태 검증만 겁니다(로그인 요구는 안 함). 다만 "읽기"까지 완전히 막아버리면
// 화면에서 정상적으로 리포트를 못 불러올 수 있어서, 본인 세션에서 만든 문서는
// 읽을 수 있게 열어뒀습니다 — 다만 지금 코드(ReportPage.jsx)가 localStorage의
// lastShareId만으로 문서를 열람하는 구조라, "본인 세션" 검증을 규칙 레벨에서
// 걸 방법이 마땅치 않습니다(로그인이 없으니 request.auth로 구분 불가).
// 그래서 테스트 단계에서는 reports 읽기를 전체 허용해뒀습니다 — 어차피 테스트
// 데이터이고 실사용자 정보가 아니므로 리스크는 낮다고 판단했으나, 테스트 중에도
// 실제 본인 얼굴/손톱 사진으로 여러 번 테스트하신다면 그 결과물(healthAge 등
// 참고 지수)이 제3자에게 열람 가능한 상태라는 점은 인지하고 계셔야 합니다.
// ------------------------------------------------------------------

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── users/{uid} ──────────────────────────────────────────────
    // 로그인 기능 자체는 테스트 단계에도 존재하므로(구글/카카오/네이버),
    // users 컬렉션은 처음부터 본인 문서만 접근 가능하도록 제한.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── reports/{reportId} ───────────────────────────────────────
    // 테스트 단계: 로그인 없이도 생성 가능(userId: 'guest' 케이스 포함).
    // 최소한의 형태 검증만 겁니다 — healthAge, actualAge 등 핵심 필드가
    // 아예 없는 빈 문서가 대량으로 쓰이는 것 정도만 방지.
    match /reports/{reportId} {
      allow create: if
        request.resource.data.keys().hasAll(['userId', 'reportData', 'timestamp']);

      // 테스트 단계는 실사용자 데이터가 아니므로 읽기 전체 허용.
      // (베타 전환 시 firestore.beta.rules에서 반드시 좁혀야 함)
      allow read: if true;

      // 이름/거주지 입력(updateDoc)도 테스트 단계는 로그인 여부와 무관하게 허용.
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['userName', 'userCity']);

      allow delete: if false;
    }

    // ── saveFailures/{id} ────────────────────────────────────────
    match /saveFailures/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── config/{docId} ───────────────────────────────────────────
    // 2026.8.21 — 재배포 없이 되돌리기 위한 런타임 설정.
    //   config/app     : { theme: 'v1' | 'v2' }
    //   config/pricing : 플랜·수당 정의
    // 공개 정보만 담는다. 개인정보·비밀값은 절대 넣지 말 것(읽기가 전체 허용이므로).
    // 쓰기는 콘솔에서만 — 클라이언트가 가격을 바꿀 수 있으면 안 된다.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
